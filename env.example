# Security Configuration
# Comma-separated list of allowed domains
ALLOWED_DOMAINS=github.com,gitlab.com,bitbucket.org
# Maximum file size to analyze in bytes (default: 5242880 = 5MB)
MAX_FILE_SIZE_BYTES=5242880

# Caching Configuration
# Redis URL (optional). If not set, uses in-memory cache.
# REDIS_URL=redis://localhost:6379

# Minimum cache TTL in seconds (default: 86400 = 1d)
CACHE_TTL_MIN_SECONDS=86400
# Cache TTL scaling factor (seconds per byte)
CACHE_TTL_PER_BYTE=0.01
# Analysis timeout in seconds (default: 60 = 1m)
ANALYSIS_TIMEOUT_SECONDS=60
# Cache TTL for timed out repositories in seconds (default: 60 = 1m)
CACHE_TTL_ON_TIMEOUT=60

# Base URL for SEO and Metadata
BASE_URL=https://example.com
